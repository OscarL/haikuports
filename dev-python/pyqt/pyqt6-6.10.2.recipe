SUMMARY="Comprehensive Python Bindings for Qt v6"
DESCRIPTION="PyQt combines all the advantages of Qt and Python. A programmer \
has all the power of Qt, but is able to exploit it with the \
simplicity of Python."
HOMEPAGE="http://www.riverbankcomputing.com/software/pyqt/"
COPYRIGHT="2015-2026 Riverbank Computing Limited"
LICENSE="GNU GPL v3"
REVISION="1"
SOURCE_URI="https://files.pythonhosted.org/packages/source/p/pyqt6/pyqt6-$portVersion.tar.gz"
CHECKSUM_SHA256="6c0db5d8cbb9a3e7e2b5b51d0ff3f283121fa27b864db6d2f35b663c9be5cc83"

ARCHITECTURES="all !x86_gcc2"
SECONDARY_ARCHITECTURES="x86"

portVersionCompat="$portVersion compat >= ${portVersion%%.*}"

# No base/main package.

REQUIRES="
	haiku$secondaryArchSuffix
	lib:libGL$secondaryArchSuffix
#	lib:libQt6Bluetooth$secondaryArchSuffix
	lib:libQt6Core$secondaryArchSuffix
#	lib:libQt6Designer$secondaryArchSuffix
	lib:libQt6DBus$secondaryArchSuffix
	lib:libQt6Gui$secondaryArchSuffix
#	lib:libQt6Help$secondaryArchSuffix
#	lib:libQt6Location$secondaryArchSuffix
#	lib:libQt6Multimedia$secondaryArchSuffix
#	lib:libQt6MultimediaWidgets$secondaryArchSuffix
	lib:libQt6Network$secondaryArchSuffix
#	lib:libQt6Nfc$secondaryArchSuffix
	lib:libQt6OpenGL$secondaryArchSuffix
	lib:libQt6OpenGLWidgets$secondaryArchSuffix
#	lib:libQt6Positioning$secondaryArchSuffix
	lib:libQt6PrintSupport$secondaryArchSuffix
#	lib:libQt6Qml$secondaryArchSuffix
#	lib:libQt6Quick$secondaryArchSuffix
#	lib:libQt6QuickWidgets$secondaryArchSuffix
#	lib:libQt6Sensors$secondaryArchSuffix
#	lib:libQt6SerialPort$secondaryArchSuffix
	lib:libQt6Sql$secondaryArchSuffix
#	lib:libQt6Svg$secondaryArchSuffix
	lib:libQt6Test$secondaryArchSuffix
#	lib:libQt6WebChannel$secondaryArchSuffix
#	lib:libQt6WebSockets$secondaryArchSuffix
	lib:libQt6Widgets$secondaryArchSuffix
	lib:libQt6Xml$secondaryArchSuffix
	"

PYTHON_VERSIONS=(3.10 3.14)
defaultVersion=3.10
pythonPackage=python${defaultVersion//.}

BUILD_REQUIRES="
	haiku${secondaryArchSuffix}_devel
	installer_$pythonPackage
	pyqt_builder_$pythonPackage
#	devel:libGL$secondaryArchSuffix
#	devel:libQt6Bluetooth$secondaryArchSuffix >= $portVersion
	devel:libQt6Core$secondaryArchSuffix >= $portVersion
#	devel:libQt6DBus$secondaryArchSuffix >= $portVersion
#	devel:libQt6Designer$secondaryArchSuffix >= $portVersion	# not really needed if using --no-designer-plugin.
#	devel:libQt6Gui$secondaryArchSuffix >= $portVersion
#	devel:libQt6Help$secondaryArchSuffix >= $portVersion
#	devel:libQt6Location$secondaryArchSuffix >= $portVersion
#	devel:libQt6Multimedia$secondaryArchSuffix >= $portVersion
#	devel:libQt6MultimediaWidgets$secondaryArchSuffix >= $portVersion
#	devel:libQt6Network$secondaryArchSuffix >= $portVersion
#	devel:libQt6Nfc$secondaryArchSuffix >= $portVersion
#	devel:libQt6OpenGL$secondaryArchSuffix >= $portVersion
#	devel:libQt6Positioning$secondaryArchSuffix >= $portVersion
#	devel:libQt6PrintSupport$secondaryArchSuffix >= $portVersion
#	devel:libQt6Qml$secondaryArchSuffix >= $portVersion			# not really needed if using --no-qml-plugin.
#	devel:libQt6Quick$secondaryArchSuffix >= $portVersion
#	devel:libQt6QuickWidgets$secondaryArchSuffix >= $portVersion
#	devel:libQt6Sensors$secondaryArchSuffix >= $portVersion
#	devel:libQt6SerialPort$secondaryArchSuffix >= $portVersion
#	devel:libQt6Sql$secondaryArchSuffix >= $portVersion
#	devel:libQt6Svg$secondaryArchSuffix >= $portVersion
#	devel:libQt6Test$secondaryArchSuffix >= $portVersion
#	devel:libQt6WebChannel$secondaryArchSuffix >= $portVersion
#	devel:libQt6WebSockets$secondaryArchSuffix >= $portVersion
#	devel:libQt6Widgets$secondaryArchSuffix >= $portVersion
#	devel:libQt6Xml$secondaryArchSuffix >= $portVersion
	"
BUILD_PREREQUIRES="
	cmd:g++$secondaryArchSuffix
	cmd:make
	cmd:python$defaultVersion
	cmd:qmake6$secondaryArchSuffix
	cmd:sip_wheel
	"

for pythonVersion in ${PYTHON_VERSIONS[@]}; do
	pythonPackage=python${pythonVersion//.}

	# Not renaming 3.10 packages to avoid needing massive packages rebuilds.
	# No need for REPLACES then. ToDo: remove the conditional after dropping 3.10.
	if [ $pythonVersion != 3.10 ]; then
		# Allows using dot in sub-package names (eg: "_python3.14" vs "_python314"):
		eval "PACKAGE_NAME_$pythonPackage=${portBaseName}_python$pythonVersion"

		eval "PROVIDES_$pythonPackage=\"
			${portName}_python$pythonVersion = $portVersion
			\""
	fi

	eval "PROVIDES_$pythonPackage+=\"
		${portName}_$pythonPackage = $portVersionCompat
		cmd:pylupdate6_$pythonVersion = $portVersion
		cmd:pyuic6_$pythonVersion = $portVersion
		\""

	if [ "$targetArchitecture" = x86_gcc2 ]; then
		eval "PROVIDES_${pythonPackage}+=\"
			${portBaseName}_$pythonPackage = $portVersionCompat
			\""
	fi

	# Provide non-suffixed cmd only for the default Python version
	if [ $pythonVersion = $defaultVersion ]; then
		eval "PROVIDES_$pythonPackage+=\"
			cmd:pylupdate6 = $portVersion
			cmd:pyuic6 = $portVersion
			\""
	fi

	eval "REQUIRES_$pythonPackage=\"
		$REQUIRES
		cmd:python$pythonVersion
		\""
	BUILD_REQUIRES+="
		installer_$pythonPackage
		"
	BUILD_PREREQUIRES+="
		cmd:python$pythonVersion
		"
done


BUILD()
{
	# when using sip-wheel, if given, --api-dir needs to be relative. Which means that on
	# INSTALL we'll need to move the (QScintilla) ".api" files to the correct location
	# ($dataDir/Qt6/qsci/api/).
	# if not given, no .api file gets added.
	local sipArgs=(
		--confirm-license
		--jobs $jobs
		--api-dir=.api		# (optional) dir for the PyQt6.api file.
		# --pep484-pyi		# (optional) Type hinting files.

		--qmake /bin/qmake6${secondaryArchSuffix/_/-}

		--no-dbus-python		# not needed?
		--no-designer-plugin
		--no-qml-plugin
		# --no-tools			# disables installation of pyuic6/pylupdate6
		--qt-shared				# not needed?
	)

	sip-wheel ${sipArgs[*]}
}

INSTALL()
{
	for pythonVersion in ${PYTHON_VERSIONS[@]}; do
		pythonPackage=python${pythonVersion//.}

		python=python$pythonVersion
		$python -m installer --p $prefix $portBaseName-$portVersion-cp310-abi3-haiku*_${effectiveTargetArchitecture}.whl

		# If the QScintilla's PyQt6.api was created, move it into the correct location.
		# We only provide that file for the default Python version.
		maybeApiFile=
		if [ $pythonVersion = $defaultVersion ]; then
			_fileName=$prefix/lib/$python/vendor-packages/.api/PyQt6.api
			if test -e $_fileName; then
				mkdir -p $dataDir/Qt6/qsci/api/
				maybeApiFile=$dataDir/Qt6/qsci/api/PyQt6.api
				mv $_fileName $maybeApiFile
			fi
		fi

		# Avoid possible left-overs:
		rm -rf $prefix/lib/$python/vendor-packages/.api

		# Version suffix all the scripts
		for f in $prefix/bin/*; do
			mv $f $f-$pythonVersion
		done

		# And provide suffix-less symlinks for the default version
		if [ $pythonVersion = $defaultVersion ]; then
			for f in $prefix/bin/*; do
				ln -sr $f ${f%-$pythonVersion}
			done
		fi

		packageEntries $pythonPackage \
			$prefix/lib/python* \
			$prefix/bin \
			$maybeApiFile

		rm -rf $dataDir
	done
}
